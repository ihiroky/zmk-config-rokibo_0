#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/rgbled_widget.dtsi>
#include "keys_jp.h"

&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&trackball {
    scroll-layers = <6>;
    workspace_actions {
        layers = <0>;
        modifiers = <LEFT_GUI>;
        tick = <75>;
        tap-ms = <30>;
        wait-ms = <333>;
        bindings = <&kp PAGE_UP>, <&kp PAGE_DOWN>, <&none>, <&none>;
    };
    zoom_actions {
        layers = <0>;
        modifiers = <LEFT_CONTROL>;
        tick = <75>;
        tap-ms = <30>;
        wait-ms = <333>;
        bindings = <&kp NUMBER_0>, <&kp NUMBER_0>, <&kp JP_PLUS>, <&kp JP_MINUS>;
    };
    zoom_alt_actions {
        layers = <0>;
        modifiers = <LEFT_ALT>;
        tick = <75>;
        tap-ms = <30>;
        wait-ms = <333>;
        bindings = <&kp LC(NUMBER_0)>, <&kp LC(NUMBER_0)>, <&kp LC(JP_CARET)>, <&kp LC(JP_MINUS)>;
    };
    copy_paste_actions {
        layers = <0>;
        modifiers = <LEFT_SHIFT>;
        tick = <75>;
        tap-ms = <30>;
        wait-ms = <333>;
        bindings = <&kp END>, <&kp HOME>, <&kp LC(C)>, <&kp LC(V)>;
    };
};

/ {
    behaviors {
        mb1_lc_mb4: mb1_lc_mb4_node {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MB1>, <&mkp MB4>;
            mods = <(MOD_LCTL)>;
        };
        mb2_lc_mb5: mb2_lc_mb5_node {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MB2>, <&mkp MB5>;
            mods = <(MOD_LCTL)>;
        };
    };

    macros {
        fzf: macro_node {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp JP_DOLLAR>, <&kp JP_LPAREN>, <&kp F>, <&kp Z>, <&kt F>, <&kp JP_RPAREN>;
            tap-ms = <10>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R              &kp T                         &kp Y                &kp U      &kp I         &kp O                &kp P
&kp A                    &kp S         &kp D         &kp F              &kp G                         &kp H                &kp J      &kp K         &kp L                &lt 5 ENTER
&kp Z                    &kp X         &kp C         &kp V              &kp B                         &kp N                &kp M      &kp JP_COMMA  &kp JP_DOT           &lt 6 JP_SLASH
&mt LEFT_CONTROL ESCAPE  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 JP_MUHENKAN  &mt LSHIFT SPACE  &lt 3 BSPC  &mt RCTRL JP_HENKAN  &lt 1 TAB                &mt RIGHT_ALT JP_AT  &mt RSHIFT JP_BACKSLASH
            >;
        };

        SYMBOL {
            bindings = <
&kp JP_PLUS   &kp JP_ASTERISK  &kp JP_QUESTION  &kp JP_AT   &kp JP_YEN               &kp JP_QUOTE      &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_DOLLAR       &kp JP_HASH
&kp JP_MINUS  &kp JP_SLASH     &kp JP_LT        &kp JP_GT   &kp JP_PIPE              &kp JP_DQUOTE     &kp JP_LPAREN    &kp JP_RPAREN    &kp JP_AMPERSAND    &kp JP_TILDE
&kp JP_EQUAL  &kp JP_PERCENT   &kp JP_COMMA     &kp JP_DOT  &kp JP_CARET             &kp JP_BACKQUOTE  &kp JP_LBRACE    &kp JP_RBRACE    &kp JP_EXCLAMATION  &kp JP_UNDERSCORE
&kp JP_COLON  &trans           &trans           &kp LCTRL   &trans        &lt 4 DEL  &trans            &trans                            &trans              &kp JP_SEMICOLON
            >;
        };

        FUNCTION_CURSOR {
            bindings = <
&kp F1        &kp F2   &kp F3   &kp F4   &kp F5           &kp PRINTSCREEN  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &kp F20          &kp C_VOLUME_UP
&kp F6        &kp F7   &kp F8   &kp F9   &kp F10          &kp LEFT_ARROW   &kp DOWN_ARROW        &kp UP_ARROW          &kp RIGHT_ARROW  &kp C_MUTE
&kp F11       &kp F12  &kp F13  &kp F14  &kp F15          &kp HOME         &kp PAGE_DOWN         &kp PAGE_UP           &kp END          &kp C_VOLUME_DOWN
&kp LEFT_GUI  &trans   &trans   &trans   &trans   &trans  &trans           &kp RIGHT_ALT  &trans                                      &trans
            >;
        };

        NUMBER {
            bindings = <
&trans             &trans  &trans  &trans  &trans          &kp JP_PLUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9    &kp JP_ASTERISK
&kp JP_UNDERSCORE  &trans  &trans  &fzf    &trans          &kp JP_MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6    &kp JP_SLASH
&trans             &trans  &trans  &trans  &trans          &kp JP_CARET  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp JP_EQUAL
&trans             &trans  &trans  &trans  &trans  &trans  &kp JP_DOT    &kp N0                      &kp JP_PERCENT  &kp JP_COMMA
            >;
        };

        SETTING {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3   &bt BT_SEL 4           &trans    &trans       &trans      &trans          &trans
&trans         &studio_unlock  &sys_reset      &bootloader    &trans                 &ind_bat  &bootloader  &sys_reset  &studio_unlock  &kp NUMBER_0
&bt BT_DISC 0  &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3  &bt BT_DISC 4          &ind_con  &trans       &trans      &trans          &trans
&trans         &bt BT_CLR      &bt BT_CLR_ALL  &trans         &trans         &trans  &trans    &trans  &trans                         &trans
            >;
        };

        MOUSE {
            bindings = <
&trans         &trans         &trans           &trans             &trans          &trans  &kp F3    &kp F5    &kp F12   &trans
&kp LEFT_GUI   &kp LEFT_ALT   &kp LEFT_SHIFT   &kp LEFT_CONTROL   &trans          &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&kp RIGHT_GUI  &kp RIGHT_ALT  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &trans          &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans         &trans         &trans           &trans             &trans  &trans  &trans  &trans  &trans              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans         &trans             &trans           &trans         &trans
&trans  &trans  &trans  &trans  &trans          &kp LEFT_GUI   &kp LEFT_CONTROL   &kp LEFT_SHIFT   &kp LEFT_ALT   &trans
&trans  &trans  &trans  &trans  &trans          &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans                                  &trans
            >;
        };

    };
};
